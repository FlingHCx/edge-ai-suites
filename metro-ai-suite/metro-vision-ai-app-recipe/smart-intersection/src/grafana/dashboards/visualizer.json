            "uid": "xU6Z19aVk"
          },
          "query": "\nfrom(bucket: \"UseCase2\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"parking_spots\")\n  // 1. Exclude the numeric field causing the collision\n  |> filter(fn: (r) => r[\"_field\"] != \"occupied\")\n  // 2. Cast all remaining field values to string as a safeguard\n  |> toString()\n  // 3. Take the most recent entry for each field\n  |> group(columns: [\"zone_id\", \"spot_id\", \"_field\"])\n  |> last()\n  // 4. Pivot fields into table columns\n  |> group(columns: [\"zone_id\", \"spot_id\"])\n  |> pivot(\n      rowKey: [\"zone_id\", \"spot_id\"],\n      columnKey: [\"_field\"],\n      valueColumn: \"_value\"\n  )\n  // 5. Merge all spots and sort\n  |> group()\n  |> sort(columns: [\"zone_id\", \"spot_id\"])\n  // 6. Select and order output columns\n  |> keep(columns: [\"zone_id\", \"spot_id\", \"status\", \"type\", \"color\", \"entry_time\", \"dwell_time\"])",
          "refId": "A"
        }
      ],
