          "query": "from(bucket: \"UseCase2\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"parking_spots\")\n  |> filter(fn: (r) => r[\"_field\"] != \"occupied\")\n  |> last()\n  |> pivot(\n      rowKey: [\"zone_id\", \"spot_id\"],\n      columnKey: [\"_field\"],\n      valueColumn: \"_value\"\n  )\n  |> group()\n  |> sort(columns: [\"zone_id\", \"spot_id\"])\n  |> keep(columns: [\"zone_id\", \"spot_id\", \"status\", \"type\", \"color\", \"license_plate\", \"plate_image\", \"lpr_alert\", \"parking_alarm\", \"entry_time\", \"dwell_time\", \"fee\"])\n",
